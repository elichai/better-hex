# Suppress the err_accum != 0 branch inside SIMD decode/check wrappers.
#
# The SIMD backends accumulate errors branchlessly, then do a final
# `if err_accum != 0 { Err } else { Ok }`. This branch depends on
# poisoned data, but it only reveals whether the input was valid — not
# which bytes were invalid. The CT property (constant-time w.r.t. data
# values) holds up to this final result branch.
#
# The scalar decode_inner returns a raw u8 accumulator with no branch,
# so it doesn't need suppression.
{
   simd_decode_result_branch
   Memcheck:Cond
   fun:*decode_ssse3*
}
{
   simd_decode_result_branch_avx2
   Memcheck:Cond
   fun:*decode_avx2*
}
{
   simd_decode_result_branch_neon
   Memcheck:Cond
   fun:*neon*decode*
}
{
   simd_check_result_branch
   Memcheck:Cond
   fun:*check_ssse3*
}
{
   simd_check_result_branch_avx2
   Memcheck:Cond
   fun:*check_avx2*
}
{
   simd_check_result_branch_neon
   Memcheck:Cond
   fun:*neon*check*
}
